# EKAA Rise Website Environment Configuration Example
# Copy to .env.local for local overrides

# Site URL (Canonical URL for SEO & Open Graph)
NEXT_PUBLIC_SITE_URL=https://ekaarise.ae

# Feature Flags
NEXT_PUBLIC_PREVIEW_MODE=true
NEXT_PUBLIC_ENABLE_LIVE_PAYMENT=false

# Analytics (Optional client credentials)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
